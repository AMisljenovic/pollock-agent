# Copy to .env and fill in. `.env` is gitignored.

# Which LLM backend to use: anthropic | openai
LLM_PROVIDER=anthropic

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
# Optional: override the API base URL for OpenAI-compatible endpoints
# (Azure OpenAI, OpenRouter, local LLMs, etc.). Leave blank for api.openai.com.
OPENAI_BASE_URL=

# Runtime knobs (optional)
POLLOCK_CANVAS_DIR=./canvas
POLLOCK_LINE_BUDGET=2000

# Pin the agent to one programming language (csharp | python | typescript | rust | go | ...).
# When unset, the model is not steered toward any language and tends to drift into HTML/poetry.
POLLOCK_LANGUAGE=python

# Per-step LLM timeout in seconds (optional, default 30).
POLLOCK_STEP_TIMEOUT_SECONDS=30
